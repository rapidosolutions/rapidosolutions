# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel deployment)
# ==============================================================================
# Set VITE_API_URL on Vercel to your deployed backend URL (without trailing slash)
VITE_API_URL=https://rapido-api-e4c0.onbelmo.uk

# Optional: Frontend website URL (defaults to https://rapidosolutions.vercel.app)
VITE_SITE_URL=https://rapidosolutions.vercel.app

# Optional: Sanity CMS configuration
VITE_SANITY_PROJECT_ID=7vlwxcu7
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01
VITE_SANITY_STUDIO_URL=https://www.sanity.io/organizations/oP1ziOL5H/project/7vlwxcu7


# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Belmo / Render deployment)
# ==============================================================================
NODE_ENV=production
PORT=4174
FRONTEND_URLS=https://rapidosolutions.vercel.app
API_PUBLIC_URL=https://rapido-api-e4c0.onbelmo.uk

# Security & Sessions
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Admin & Notifications
ADMIN_EMAIL=rapidosolutionsco@outlook.com
ADMIN_PASSWORD=replace-with-a-strong-password
CV_ADMIN_EMAIL=rapidosolutionsco@outlook.com
CV_ADMIN_PASSWORD=replace-with-a-strong-password-for-cv-admin-bootstrap
CV_ADMIN_COOKIE_NAME=rapido_cv_admin_session
CONTACT_RECIPIENT_EMAIL=rapidosolutionsco@outlook.com

# Optional WhatsApp Baileys session directory (use a persistent disk in production)
# WHATSAPP_AUTH_DIR=/var/data/whatsapp-auth

# Supabase Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=rapidosolutionsco@outlook.com

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Gemini AI (Resume Analyzer & ATS Builder)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
